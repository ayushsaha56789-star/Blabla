# SaathChalo production settings. Copy to deploy/.env on the server and fill in. Never commit the real .env
# (deploy/.gitignore keeps it out of git). Generate random values with: openssl rand -base64 32

# The domain, without https:// (its DNS must point at this server). Caddy gets the HTTPS certificate for it.
SITE_ADDRESS=saathchalo.example

# Database password (any long random value).
DB_PASSWORD=

# Login tokens: a random value of at least 32 characters.
JWT_SECRET=
# Encrypts 2FA secrets, licence numbers and other sensitive fields: base64 of 32 random bytes.
# Keep a safe copy: without it, encrypted data can't be read back.
DATA_ENCRYPTION_KEY=

# The owner's number (+91…): made super admin at first login.
SUPER_ADMIN_PHONE=

# Text messages (login codes, SOS). Indian numbers need DLT registration of the sender and templates.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a sender number/ID or a messaging service:
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Email (email confirmation codes) through any SMTP service. Port 587 (STARTTLS) or 465 (TLS).
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@saathchalo.example

# Payments: none (online payments off) or razorpay.
PAYMENTS_PROVIDER=none
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# Shown on the Grievance officer page (IT Rules 2021).
LEGAL_COMPANY=
GRIEVANCE_OFFICER=
GRIEVANCE_EMAIL=
LEGAL_ADDRESS=

# Last day (YYYY-MM-DD) of the free promotions launch offer; blank = free.
PROMOTIONS_FREE_UNTIL=

# Only for a private test server without SMS/email accounts: true writes login codes to the log. Never on the real site.
ALLOW_CONSOLE_SENDERS=false
